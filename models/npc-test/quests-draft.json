  "quests": [
    {
      "id": "quest_report_wolf_escape",
      "status": "draft",
      "title": "북문의 소동",
      "summary": "같은 사건을 해결하지만, 누구의 의뢰로 수행하느냐에 따라 과정·퍼지는 정보는 달라진다. 보상과 스토리 결과는 동일하다.",

      "introNpcRef": "scout",
      "introDialogue": "북문에서 늑대가 빠져나왔어. 촌장·상인·경비 중 누구 편에서 이 일을 맡을지 정해.",

      "playerInputHintFinal": "최종 단계 입력 예: 북문에서 늑대 3마리가 탈출했다",
      "expectedParseExample": {
        "subjectContains": "늑대",
        "actionType": "tactical_move",
        "targetContains": "북문",
        "quantity": 3
      },

      "sharedObjectives": [
        {
          "id": "obj_resolve_incident",
          "type": "quest_complete",
          "description": "북문 소동 처리 완료 (모든 의뢰인 경로 공통)",
          "required": true
        }
      ],

      "finalObjective": {
        "id": "obj_deliver_report",
        "type": "turn_in_fact",
        "description": "조사·절차를 마친 뒤 최종 보고 문장 입력",
        "factMatch": {
          "subjectContains": "늑대",
          "actionType": "tactical_move",
          "targetContains": "북문",
          "minQuantity": 1,
          "minCertainty": 0.35
        }
      },

      "outcome": {
