{
  "version": 2,
  "_meta": {
    "purpose": "퀘스트 초안. 수시 수정용. 엔진 연동 전 데이터 정의만 포함.",
    "designPattern": "동일 outcome + 의뢰인(questGiver)별 과정(processSteps)·정보 경험 차이",
    "designPatternAlt": "선택: 최종 전달 대상(turnInTarget)을 의뢰인과 다르게 둘 수 있음",
    "lastUpdated": "2026-05-27",
    "editorNotes": [
      "outcome 은 모든 의뢰인·경로에서 동일 (보상·스토리 플래그)",
      "questGivers[].processSteps 로 '과정' 차별화 (장소·대사·중간 목표)",
      "questGivers[].experience 로 왜곡·KB·연출 차별화",
      "플레이어 선택 저장 필드(연동 시): QuestInstance.chosenQuestGiverId",
      "objective.factMatch 는 파서/왜곡 결과(interpretedFacts)와 대조",
      "turnInTargets 가 없으면 최종 전달 = 해당 의뢰인(npcProfileRef)"
    ],
    "glossary": {
      "questGiver": "퀘스트를 누구에게서 받아 수행하는지 → 과정 분기",
      "turnInTarget": "최종 사실을 누구에게 전달하는지 → 전파·왜곡 분기 (생략 시 의뢰인에게 전달)",
      "outcome": "모든 경로 공통 결과 (gold/xp/worldFlags)"
    }
  },

