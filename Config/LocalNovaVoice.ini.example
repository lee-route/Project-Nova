[/Script/NovaUproject.NovaVoiceSettings]
; Copy this file to Config/LocalNovaVoice.ini and fill in your Azure Speech key.
; LocalNovaVoice.ini is gitignored.
AzureSubscriptionKey=YOUR_AZURE_SPEECH_KEY_HERE
AzureRegion=koreacentral
AzureLanguage=ko-KR
; Optional: partial Windows mic name (e.g. Hands-Free). Leave empty for auto-detect/retry.
CaptureDeviceName=
